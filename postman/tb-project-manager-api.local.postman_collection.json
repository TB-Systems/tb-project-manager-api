            "description": "Retorna 200 quando a API esta no ar."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const setCookieHeaders = pm.response.headers.all()",
                  "  .filter((header) => header.key.toLowerCase() === 'set-cookie')",
                  "  .map((header) => header.value);",
                  "",
                  "const csrfCookie = setCookieHeaders.find((value) => value.startsWith('project_manager_csrf='));",
                  "",
                  "if (csrfCookie) {",
                  "  const csrfToken = csrfCookie.split(';')[0].split('=')[1];",
                  "  pm.environment.set('csrfToken', csrfToken);",
                  "}",
                  "",
                  "const body = pm.response.json();",
                  "if (body && body.id) {",
                  "  pm.environment.set('userId', String(body.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login",
            "description": "Faz login e salva o cookie CSRF no environment como `csrfToken`."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.environment.unset('csrfToken');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/logout"
          },
          "response": []
        }
      ]
    },
